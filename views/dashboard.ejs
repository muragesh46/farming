<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <style>
        body { font-family: Arial; text-align: center; padding: 50px; }
        .folder-btn { padding: 20px 40px; margin: 20px; font-size: 24px; cursor: pointer; display:block; }
    </style>
</head>
<body>
<h1 id="welcomeText">Welcome</h1>
<button class="folder-btn" id="growCropBtn" onclick="handleGrowCrop()"></button>
<button class="folder-btn" id="fertilizersBtn" onclick="handleFertilizers()"></button>
<button class="folder-btn" id="marketplaceBtn" onclick="handleMarketplace()"></button>

<script>
    // Language selection
    const lang = localStorage.getItem('userLanguage') || 'en';
    // Language texts
    const texts = {
        welcome: {
            en: "Welcome to Smart Farming Assistant",
            hi: "स्मार्ट खेती सहायक में आपका स्वागत है",
            kn: "ಸ್ಮಾರ್ಟ್ ಕೃಷಿ ಸಹಾಯಕಕ್ಕೆ ಸ್ವಾಗತ"
        },
        growCrop: {
            en: "Grow Crop",
            hi: "फसल उगाएं",
            kn: "ಬೆಳೆ ಬೆಳೆಸಿ"
        },
        fertilizers: {
            en: "Fertilizers",
            hi: "उर्वरक",
            kn: "ಸಸ್ಯಾಹಾರಗಳು"
        },
        marketplace: {
            en: "Marketplace",
            hi: "बाजार",
            kn: "ಮಾರ್ಕೆಟ್‌ಪ್ಲೇಸ್"
        },
        helpBot: {
            en: "Help Bot",
            hi: "सहायता बोट",
            kn: "ಸಹಾಯ ಬಾಟ್"
        },
        helpPlaceholder: {
            en: "Type your question...",
            hi: "अपना सवाल लिखें...",
            kn: "ನಿಮ್ಮ ಪ್ರಶ್ನೆಯನ್ನು ಟೈಪ್ ಮಾಡಿ..."
        },
        send: {
            en: "Send",
            hi: "भेजें",
            kn: "ಕಳುಹಿಸಿ"
        }
    };

    // Set dynamic text
    document.getElementById('welcomeText').innerText = texts.welcome[lang];
    document.getElementById('growCropBtn').innerText = texts.growCrop[lang];
    document.getElementById('fertilizersBtn').innerText = texts.fertilizers[lang];
    document.getElementById('marketplaceBtn').innerText = texts.marketplace[lang];
    document.querySelector('#helpChat h5').innerText = texts.helpBot[lang];
    document.getElementById('helpInput').placeholder = texts.helpPlaceholder[lang];
    document.querySelector('#helpChat button').innerText = texts.send[lang];

    // --- API Placeholder Functions ---
    // Simulate API for Grow Crop
    function apiGrowCrop(location) {
        // Placeholder: Replace with actual API integration
        alert(`[API] Grow Crop called with location: ${location ? JSON.stringify(location) : "No location"}`);
    }
    // Simulate API for Fertilizers
    function apiFertilizers() {
        // Placeholder: Replace with actual API integration
        alert("[API] Fertilizers called");
    }
    // Simulate API for Marketplace
    function apiMarketplace() {
        // Placeholder: Replace with actual API integration
        alert("[API] Marketplace called");
    }

    // --- Folder Button Handlers ---
    function handleGrowCrop() {
        // Try to get geolocation automatically
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function(pos) {
                    apiGrowCrop({ lat: pos.coords.latitude, lon: pos.coords.longitude });
                },
                function(error) {
                    // On error, call API without location
                    apiGrowCrop(null);
                }
            );
        } else {
            apiGrowCrop(null);
        }
    }
    function handleFertilizers() {
        apiFertilizers();
    }
    function handleMarketplace() {
        apiMarketplace();
    }

    // --- Help Bot Persistent with Voice Support ---
    let helpBotActive = false;
    function toggleHelpChat() {
        helpBotActive = !helpBotActive;
        document.getElementById('helpChat').style.display = helpBotActive ? 'block' : 'none';
    }
    function sendHelpMessage() {
        const input = document.getElementById('helpInput');
        const msg = input.value.trim();
        if (!msg) return;
        appendChatMessage('user', msg);
        input.value = '';
        // Simulate Help Bot reply (placeholder)
        setTimeout(() => {
            const reply = helpBotReply(msg);
            appendChatMessage('bot', reply);
            speakText(reply);
        }, 700);
    }
    function appendChatMessage(sender, text) {
        const chat = document.getElementById('chatContent');
        const div = document.createElement('div');
        div.style.margin = "6px 0";
        div.style.textAlign = sender === 'user' ? 'right' : 'left';
        div.innerHTML = `<span style="background:#${sender === 'user' ? 'e0ffe0' : 'f0f0f0'};padding:5px 10px;border-radius:10px;display:inline-block;">${text}</span>`;
        chat.appendChild(div);
        chat.scrollTop = chat.scrollHeight;
    }
    // Placeholder Help Bot reply function
    function helpBotReply(msg) {
        // Replace with actual bot logic or API
        if (msg.toLowerCase().includes("crop")) {
            return {
                en: "To grow crops, click the Grow Crop button. We'll use your location to suggest crops.",
                hi: "फसल उगाने के लिए 'फसल उगाएं' बटन पर क्लिक करें। हम आपकी स्थिति के अनुसार सुझाव देंगे।",
                kn: "ಬೆಳೆ ಬೆಳೆಸಲು 'ಬೆಳೆ ಬೆಳೆಸಿ' ಬಟನ್ ಕ್ಲಿಕ್ ಮಾಡಿ. ನಿಮ್ಮ ಸ್ಥಳವನ್ನು ಬಳಸುತ್ತೇವೆ."
            }[lang];
        }
        if (msg.toLowerCase().includes("fertilizer")) {
            return {
                en: "Fertilizers section helps you choose the best nutrients for your crops.",
                hi: "उर्वरक अनुभाग आपको अपनी फसलों के लिए सर्वोत्तम पोषक तत्व चुनने में मदद करता है।",
                kn: "ಸಸ್ಯಾಹಾರ ವಿಭಾಗವು ನಿಮ್ಮ ಬೆಳೆಗಳಿಗೆ ಉತ್ತಮ ಪೋಷಕಾಂಶಗಳನ್ನು ಆಯ್ಕೆ ಮಾಡಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."
            }[lang];
        }
        return {
            en: "How can I assist you? Ask me about crops, fertilizers, or the marketplace.",
            hi: "मैं आपकी कैसे मदद कर सकता हूँ? मुझसे फसल, उर्वरक या बाजार के बारे में पूछें।",
            kn: "ನಾನು ನಿಮಗೆ ಹೇಗೆ ಸಹಾಯ ಮಾಡಬಹುದು? ಬೆಳೆ, ಸಸ್ಯಾಹಾರ ಅಥವಾ ಮಾರ್ಕೆಟ್‌ಪ್ಲೇಸ್ ಬಗ್ಗೆ ಕೇಳಿ."
        }[lang];
    }
    // Voice support using Web Speech API
    function speakText(text) {
        if ('speechSynthesis' in window) {
            const utter = new SpeechSynthesisUtterance(text);
            utter.lang = lang === 'hi' ? 'hi-IN' : (lang === 'kn' ? 'kn-IN' : 'en-US');
            window.speechSynthesis.speak(utter);
        }
    }

    // Persistent Help Bot: always stays on page
    // (Already implemented as floating button)
</script>
<!-- Help Bot Floating Button -->
<div id="helpBot" style="
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 1000;
">
    <button onclick="toggleHelpChat()" style="
        background-color: #4CAF50;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        border: none;
        color: white;
        font-size: 30px;
        cursor: pointer;
    ">💬</button>

    <div id="helpChat" style="
        display: none;
        position: absolute;
        bottom: 70px;
        right: 0;
        width: 300px;
        height: 400px;
        background: white;
        border: 2px solid #4CAF50;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        overflow-y: auto;
        padding: 10px;
    ">
        <h5 style="color:#4CAF50;">Help Bot</h5>
        <div id="chatContent" style="height: 300px; overflow-y: auto;"></div>
        <input type="text" id="helpInput" placeholder="Type your question..." style="width: 100%; padding: 5px;">
        <button onclick="sendHelpMessage()" style="width:100%; margin-top:5px; background:#4CAF50; color:white;">Send</button>
    </div>
</div>
</body>
</html>