<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Fertilizer Recommendations</title>
  <style>
    /* Reset & base */
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f0f9f8;
      color: #333;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }
    main {
      flex: 1;
      max-width: 900px;
      margin: 1rem auto 5rem;
      padding: 1rem 1.5rem;
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 4px 12px rgb(0 0 0 / 0.1);
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    h1 {
      text-align: center;
      margin-bottom: 0.5rem;
      color: #0b665c;
    }
    label {
      font-weight: 600;
      margin-bottom: 0.25rem;
      display: block;
      color: #0b665c;
    }
    select {
      width: 100%;
      padding: 0.5rem 0.75rem;
      font-size: 1rem;
      border: 2px solid #0b665c;
      border-radius: 6px;
      background: #e6f2f0;
      color: #0b665c;
      transition: border-color 0.3s ease;
    }
    select:focus {
      outline: none;
      border-color: #0f8f7f;
      background: #d8edea;
    }
    .form-row {
      display: flex;
      flex-direction: column;
      max-width: 400px;
      margin: 0 auto;
    }
    #recommendations {
      background: #d8edea;
      border-radius: 10px;
      padding: 1rem 1.25rem;
      min-height: 120px;
      font-size: 1.1rem;
      color: #0b665c;
      white-space: pre-wrap;
      box-shadow: inset 0 0 6px rgb(11 102 92 / 0.3);
    }
    .nutrient-buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 1rem;
    }
    .nutrient-btn {
      background: #0b665c;
      color: white;
      border: none;
      border-radius: 8px;
      padding: 0.6rem 1.2rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 8px rgb(11 102 92 / 0.4);
      transition: background-color 0.3s ease;
      user-select: none;
    }
    .nutrient-btn:hover,
    .nutrient-btn:focus {
      background: #0f8f7f;
      outline: none;
    }

    /* Help Bot container fixed bottom right */
    #help-bot {
      position: fixed;
      bottom: 1rem;
      right: 1rem;
      width: 320px;
      max-width: 90vw;
      background: #0b665c;
      border-radius: 16px 16px 0 16px;
      box-shadow: 0 8px 20px rgb(11 102 92 / 0.6);
      color: white;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      z-index: 9999;
    }
    #help-bot-header {
      background: #0f8f7f;
      padding: 0.5rem 1rem;
      cursor: pointer;
      user-select: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    #help-bot-header h2 {
      margin: 0;
      font-size: 1.1rem;
      font-weight: 700;
    }
    #help-bot-toggle {
      background: transparent;
      border: none;
      color: white;
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
      user-select: none;
      padding: 0;
    }
    #help-bot-content {
      background: #0b665c;
      padding: 0.75rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      max-height: 300px;
      overflow-y: auto;
    }
    #help-bot-messages {
      flex: 1 1 auto;
      overflow-y: auto;
      max-height: 180px;
      background: #0f8f7f;
      padding: 0.5rem;
      border-radius: 10px;
      font-size: 0.9rem;
      line-height: 1.3;
      color: #e0f0ef;
      user-select: text;
    }
    #help-bot-input-container {
      margin-top: 0.5rem;
      display: flex;
      gap: 0.5rem;
    }
    #help-bot-input {
      flex: 1 1 auto;
      padding: 0.4rem 0.75rem;
      border-radius: 8px;
      border: none;
      font-size: 1rem;
      outline: none;
    }
    #help-bot-send-btn {
      background: #0f8f7f;
      border: none;
      border-radius: 8px;
      padding: 0.4rem 1rem;
      color: white;
      font-weight: 600;
      cursor: pointer;
      user-select: none;
      transition: background-color 0.3s ease;
    }
    #help-bot-send-btn:hover,
    #help-bot-send-btn:focus {
      background: #0b665c;
      outline: none;
    }
    #help-bot-voice-btn {
      background: transparent;
      border: none;
      color: white;
      font-size: 1.3rem;
      cursor: pointer;
      user-select: none;
      margin-left: 0.5rem;
      padding: 0;
      align-self: center;
    }
    #help-bot-voice-btn.listening {
      color: #ff6961;
      animation: pulse 1.2s infinite;
    }
    @keyframes pulse {
      0%, 100% {opacity: 1;}
      50% {opacity: 0.5;}
    }

    /* Responsive */
    @media (max-width: 480px) {
      main {
        margin: 1rem 0.5rem 6rem;
        padding: 1rem;
      }
      #help-bot {
        width: 90vw;
        right: 5vw;
        bottom: 1rem;
        border-radius: 16px;
      }
      .nutrient-buttons {
        gap: 0.75rem;
      }
      .nutrient-btn {
        flex: 1 1 45%;
        text-align: center;
      }
    }
  </style>
</head>
<body>
  <main>
    <h1 id="page-title">Fertilizer Recommendations</h1>

    <div class="form-row">
      <label for="crop-select" id="label-crop">Select Crop Type</label>
      <select id="crop-select" aria-label="Select Crop Type">
        <option value="" disabled selected>-- Select Crop --</option>
      </select>
    </div>

    <div class="form-row">
      <label for="stage-select" id="label-stage">Select Growth Stage</label>
      <select id="stage-select" aria-label="Select Growth Stage" disabled>
        <option value="" disabled selected>-- Select Stage --</option>
      </select>
    </div>

    <div id="recommendations" aria-live="polite" aria-atomic="true" role="region" aria-label="Fertilizer Recommendations">
      Please select a crop type and growth stage to see recommendations.
    </div>

    <div class="nutrient-buttons" role="group" aria-label="Nutrient Deficiency Solutions">
      <button class="nutrient-btn" data-nutrient="nitrogen" type="button" aria-describedby="desc-nitrogen">Nitrogen</button>
      <button class="nutrient-btn" data-nutrient="phosphorus" type="button" aria-describedby="desc-phosphorus">Phosphorus</button>
      <button class="nutrient-btn" data-nutrient="potassium" type="button" aria-describedby="desc-potassium">Potassium</button>
    </div>

    <p id="desc-nitrogen" class="sr-only">Show solution for nitrogen deficiency</p>
    <p id="desc-phosphorus" class="sr-only">Show solution for phosphorus deficiency</p>
    <p id="desc-potassium" class="sr-only">Show solution for potassium deficiency</p>
  </main>

  <aside id="help-bot" aria-label="Help Bot" role="complementary">
    <div id="help-bot-header" tabindex="0" aria-expanded="true" aria-controls="help-bot-content" role="button">
      <h2 id="help-bot-title">Help Bot</h2>
      <button id="help-bot-toggle" aria-label="Toggle Help Bot Panel" title="Toggle Help Bot Panel" type="button">&#x2715;</button>
    </div>
    <section id="help-bot-content" role="region" aria-live="polite" aria-atomic="false">
      <div id="help-bot-messages" aria-live="polite" aria-relevant="additions" aria-label="Help Bot messages"></div>
      <div id="help-bot-input-container">
        <input type="text" id="help-bot-input" aria-label="Type your question" placeholder="Ask me anything..." autocomplete="off" />
        <button id="help-bot-send-btn" type="button" aria-label="Send message">Send</button>
        <button id="help-bot-voice-btn" type="button" aria-label="Start voice input" title="Start voice input">&#127908;</button>
      </div>
    </section>
  </aside>

  <script src="/routes/fertilizers.js"></script>
  <script>
    // Language support from localStorage
    (function(){
      const lang = localStorage.getItem('language') || 'en';
      // This example only supports English but placeholder for extension
      if(lang !== 'en'){
        // If translations are available, replace text content here
        // For now, fallback to English
      }
    })();
  </script>
</body>
</html>
